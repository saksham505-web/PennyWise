<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Money Llama - your friendly money buddy</title>
<link rel="icon" href="/static/llama.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@500;700;800;900&family=Noto+Sans+Devanagari:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root {
    /* Theme: Biscay Bay + Deep Lagoon */
    --lagoon: #005366;
    --lagoon-deep: #003a48;
    --lagoon-ink: #00303c;
    --biscay: #097988;
    --biscay-bright: #14a0b3;
    --biscay-shadow: #065a66;
    --biscay-tint: #e1f2f4;

    --sand: #f6eedf;
    --cream: #fff8ea;
    --white: #ffffff;
    --ink: #12333b;
    --muted: #5d7b82;
    --line: #d6e4e6;
    --gold: #f5b83d;
    --gold-shadow: #d09112;
    --gold-tint: #fff0cc;
    --coffee: #5a3a22;

    --font: "Nunito", ui-rounded, "Segoe UI", system-ui, "Noto Sans Devanagari", sans-serif;
  }

  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }

  body {
    font-family: var(--font);
    color: var(--ink);
    background:
      radial-gradient(900px 520px at 12% 8%, rgba(20, 160, 179, .55), transparent 60%),
      radial-gradient(800px 500px at 92% 95%, rgba(0, 28, 36, .65), transparent 60%),
      var(--lagoon);
    overflow: hidden;
  }

  /* floating bubbles in the background */
  .bubbles { position: fixed; inset: 0; pointer-events: none; overflow: hidden; }
  .bubbles i {
    position: absolute; bottom: -60px; border-radius: 50%;
    background: rgba(255, 255, 255, .07);
    border: 2px solid rgba(255, 255, 255, .08);
    animation: rise linear infinite;
  }
  .bubbles i:nth-child(1) { left: 6%;  width: 38px; height: 38px; animation-duration: 18s; }
  .bubbles i:nth-child(2) { left: 22%; width: 18px; height: 18px; animation-duration: 13s; animation-delay: -4s; }
  .bubbles i:nth-child(3) { left: 41%; width: 54px; height: 54px; animation-duration: 24s; animation-delay: -9s; }
  .bubbles i:nth-child(4) { left: 63%; width: 24px; height: 24px; animation-duration: 16s; animation-delay: -2s; }
  .bubbles i:nth-child(5) { left: 78%; width: 42px; height: 42px; animation-duration: 21s; animation-delay: -12s; }
  .bubbles i:nth-child(6) { left: 92%; width: 20px; height: 20px; animation-duration: 15s; animation-delay: -7s; }
  @keyframes rise { to { transform: translateY(-115vh); } }

  .app {
    position: relative;
    height: 100dvh;
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 480px);
    gap: 56px;
    align-items: center;
  }

  /* ---------- Hero (left side) ---------- */
  .hero { text-align: center; color: var(--cream); }

  .speech {
    position: relative;
    display: inline-block;
    background: var(--white);
    color: var(--ink);
    font-weight: 800;
    font-size: 18px;
    padding: 14px 20px;
    border-radius: 20px;
    border-bottom: 5px solid var(--line);
    margin-bottom: 22px;
  }
  .speech::after {
    content: "";
    position: absolute; left: 50%; bottom: -14px; margin-left: -12px;
    width: 0; height: 0;
    border-left: 12px solid transparent;
    border-right: 12px solid transparent;
    border-top: 14px solid var(--white);
  }

  .llama-wrap { position: relative; display: inline-block; }
  .llama-wrap img.llama {
    display: block;
    height: min(46vh, 400px);
    width: auto;
    animation: bob 2.6s ease-in-out infinite;
    transform-origin: 50% 100%;
    filter: drop-shadow(0 6px 0 rgba(0, 0, 0, .12));
  }
  .llama-wrap .ground {
    width: 60%; height: 16px; margin: 6px auto 0;
    background: rgba(0, 0, 0, .22);
    border-radius: 50%;
    animation: shadow 2.6s ease-in-out infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-1.5deg); }
    50%      { transform: translateY(-14px) rotate(1.5deg); }
  }
  @keyframes shadow {
    0%, 100% { transform: scaleX(1);   opacity: 1; }
    50%      { transform: scaleX(.82); opacity: .7; }
  }

  .hero h1 {
    margin: 18px 0 4px;
    font-size: clamp(32px, 4.2vw, 46px);
    font-weight: 900;
    letter-spacing: -.5px;
  }
  .hero p.tag { margin: 0 auto 18px; max-width: 420px; font-size: 18px; font-weight: 700; color: #bfe3e8; }


  /* ---------- Chat card ---------- */
  .chat {
    display: flex; flex-direction: column;
    height: min(740px, calc(100dvh - 48px));
    background: var(--cream);
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 8px 0 var(--lagoon-ink), 0 32px 64px rgba(0, 0, 0, .35);
  }

  .head {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 16px;
    background: var(--biscay);
    color: var(--white);
    border-bottom: 4px solid var(--biscay-shadow);
  }
  .head .who { flex: 1; min-width: 0; }
  .head .name { font-weight: 900; font-size: 18px; line-height: 1.15; }
  .head .sub { font-size: 13px; font-weight: 700; color: #cdeef2; display: flex; align-items: center; gap: 6px; }
  .head .sub::before {
    content: ""; width: 9px; height: 9px; border-radius: 50%;
    background: #8cf0c8; box-shadow: 0 0 0 3px rgba(140, 240, 200, .25);
  }
  .avatar {
    flex: none;
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--cream) url("/static/llama.png") no-repeat;
    background-size: 170%;
    background-position: 65% 3%;
    border: 3px solid var(--white);
  }
  .btn-reset {
    font-family: inherit; font-weight: 800; font-size: 13px;
    color: var(--white); cursor: pointer;
    background: rgba(255, 255, 255, .16);
    border: 0; border-bottom: 3px solid rgba(0, 0, 0, .22);
    border-radius: 12px; padding: 8px 12px;
  }
  .btn-reset:hover { background: rgba(255, 255, 255, .26); }
  .btn-reset:active { transform: translateY(2px); border-bottom-width: 1px; }

  .messages {
    flex: 1; overflow-y: auto;
    padding: 18px 16px 8px;
    display: flex; flex-direction: column; gap: 14px;
    background:
      radial-gradient(#ead9b8 1px, transparent 1.6px) 0 0 / 22px 22px,
      var(--cream);
    scroll-behavior: smooth;
  }

  .row { display: flex; gap: 10px; align-items: flex-end; animation: pop .22s ease-out both; }
  .row.user { justify-content: flex-end; }
  .row .av {
    flex: none; width: 38px; height: 38px; border-radius: 50%;
    background: var(--cream) url("/static/llama.png") no-repeat;
    background-size: 170%; background-position: 65% 3%;
    border: 2px solid var(--biscay);
  }
  @keyframes pop {
    from { opacity: 0; transform: translateY(8px) scale(.98); }
    to   { opacity: 1; transform: none; }
  }

  .bubble {
    max-width: 82%;
    padding: 12px 15px;
    font-size: 16px; line-height: 1.45; font-weight: 600;
    overflow-wrap: anywhere;
  }
  .row.bot .bubble {
    background: var(--white);
    border: 2px solid var(--line); border-bottom-width: 4px;
    border-radius: 20px 20px 20px 6px;
  }
  .row.user .bubble {
    background: var(--biscay); color: var(--white); font-weight: 700;
    border: 2px solid var(--biscay-shadow); border-bottom-width: 4px;
    border-radius: 20px 20px 6px 20px;
  }
  .bubble p { margin: 0 0 8px; }
  .bubble p:last-child { margin-bottom: 0; }

  ul.pts { list-style: none; padding: 0; margin: 4px 0 8px; display: grid; gap: 6px; }
  ul.pts li { position: relative; padding-left: 22px; }
  ul.pts li::before {
    content: ""; position: absolute; left: 3px; top: .5em;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--biscay); box-shadow: 0 2px 0 var(--biscay-shadow);
  }

  .box { margin: 8px 0; padding: 10px 12px; border-radius: 14px; border: 2px solid; }
  .box .label {
    display: inline-block; font-size: 11px; font-weight: 900; letter-spacing: .8px;
    text-transform: uppercase; padding: 2px 8px; border-radius: 999px; margin-bottom: 4px;
  }
  .box.ex  { background: var(--biscay-tint); border-color: #b8dde2; }
  .box.ex .label  { background: var(--biscay); color: var(--white); }
  .box.rem { background: var(--gold-tint); border-color: #f0d38a; }
  .box.rem .label { background: var(--gold); color: var(--coffee); }

  .lesson {
    display: inline-flex; align-items: center; gap: 6px;
    margin-top: 8px; padding: 5px 10px;
    font-size: 13px; font-weight: 800; color: var(--biscay-shadow);
    background: var(--biscay-tint); border-radius: 999px;
  }
  .lesson svg { width: 14px; height: 14px; flex: none; }

  /* Duolingo-style chunky buttons */
  .chip, .suggest {
    font-family: inherit; font-weight: 800; font-size: 14px; cursor: pointer;
    color: var(--biscay);
    background: var(--white);
    border: 2px solid var(--line); border-bottom-width: 4px;
    border-radius: 14px; padding: 8px 14px;
    transition: transform .06s, background .12s;
  }
  .chip:hover, .suggest:hover { background: var(--biscay-tint); border-color: var(--biscay); }
  .chip:active, .suggest:active { transform: translateY(2px); border-bottom-width: 2px; }
  .suggest { display: block; margin-top: 10px; text-align: left; }

  /* Quiz */
  .q { font-weight: 900; margin: 12px 0 6px; }
  .opts { display: grid; gap: 8px; }
  .opt {
    display: flex; align-items: center; gap: 10px; width: 100%; text-align: left;
    font-family: inherit; font-weight: 700; font-size: 15px; color: var(--ink); cursor: pointer;
    background: var(--white);
    border: 2px solid var(--line); border-bottom-width: 4px;
    border-radius: 14px; padding: 9px 12px;
    transition: transform .06s, background .12s, border-color .12s;
  }
  .opt .k {
    flex: none; width: 28px; height: 28px; border-radius: 9px;
    display: grid; place-items: center;
    font-weight: 900; font-size: 14px;
    border: 2px solid var(--line); color: var(--muted);
  }
  .opt:hover { border-color: var(--biscay); }
  .opt:active { transform: translateY(2px); border-bottom-width: 2px; }
  .opt.picked { background: var(--biscay-tint); border-color: var(--biscay); }
  .opt.picked .k { background: var(--biscay); border-color: var(--biscay); color: var(--white); }
  .opts.locked .opt { pointer-events: none; opacity: .75; }

  .btn-main {
    display: block; width: 100%; margin-top: 14px;
    font-family: inherit; font-weight: 900; font-size: 15px; letter-spacing: .5px; text-transform: uppercase;
    color: var(--white); cursor: pointer;
    background: var(--biscay);
    border: 0; border-bottom: 5px solid var(--biscay-shadow);
    border-radius: 16px; padding: 12px 16px;
  }
  .btn-main:hover:not(:disabled) { background: var(--biscay-bright); }
  .btn-main:active:not(:disabled) { transform: translateY(3px); border-bottom-width: 2px; }
  .btn-main:disabled { background: #dfe6e7; color: #9db0b4; border-bottom-color: #c5d2d4; cursor: not-allowed; }

  /* typing dots */
  .dots { display: flex; gap: 5px; padding: 6px 2px; }
  .dots span {
    width: 9px; height: 9px; border-radius: 50%; background: var(--biscay);
    animation: hop 1s ease-in-out infinite;
  }
  .dots span:nth-child(2) { animation-delay: .15s; }
  .dots span:nth-child(3) { animation-delay: .3s; }
  @keyframes hop { 0%, 60%, 100% { transform: translateY(0); opacity: .45; } 30% { transform: translateY(-6px); opacity: 1; } }

  .chips {
    display: flex; gap: 8px; overflow-x: auto; padding: 10px 16px 2px;
    scrollbar-width: none; background: var(--cream);
  }
  .chips::-webkit-scrollbar { display: none; }
  .chips .chip { flex: none; white-space: nowrap; }
  .chips.hidden { display: none; }

  .composer { padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px)); background: var(--cream); }
  .composer form { display: flex; gap: 10px; }
  .composer input {
    flex: 1; min-width: 0;
    font-family: inherit; font-weight: 700; font-size: 16px; color: var(--ink);
    background: var(--white);
    border: 2px solid var(--line); border-bottom-width: 4px;
    border-radius: 16px; padding: 12px 14px; outline: none;
  }
  .composer input::placeholder { color: #8aa3a8; font-weight: 600; }
  .composer input:focus { border-color: var(--biscay); }
  .send {
    flex: none; width: 54px; cursor: pointer;
    background: var(--biscay); color: var(--white);
    border: 0; border-bottom: 5px solid var(--biscay-shadow);
    border-radius: 16px; display: grid; place-items: center;
  }
  .send:hover:not(:disabled) { background: var(--biscay-bright); }
  .send:active:not(:disabled) { transform: translateY(3px); border-bottom-width: 2px; }
  .send:disabled { opacity: .55; cursor: not-allowed; }
  .send svg { width: 24px; height: 24px; }
  .note { margin: 8px 0 0; text-align: center; font-size: 12px; font-weight: 700; color: var(--muted); }

  :focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }

  /* ---------- Phones and small screens ---------- */
  @media (max-width: 880px) {
    body { overflow: auto; }
    .app { display: block; padding: 0; height: 100dvh; max-width: none; }
    .hero { display: none; }
    .chat { height: 100dvh; border-radius: 0; box-shadow: none; }
    .bubble { max-width: 86%; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  }
</style>
</head>
<body>
<div class="bubbles" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>

<main class="app">
  <!-- Left side: the llama -->
  <section class="hero" aria-hidden="true">
    <div class="speech">Oops!! Got Scammed Again?</div><br>
    <div class="llama-wrap">
      <img class="llama" src="/static/llama.png" alt="">
      <div class="ground"></div>
    </div>
    <h1>Money Llama</h1>
    <p class="tag">UPI safety, saving, SIP and more. One tiny lesson at a time.</p>
  </section>

  <!-- Right side: the chat -->
  <section class="chat" aria-label="Chat with Money Llama">
    <header class="head">
      <div class="avatar" role="img" aria-label="Money Llama"></div>
      <div class="who">
        <div class="name">Money Llama</div>
        <div class="sub">Your friendly money buddy</div>
      </div>
      <button class="btn-reset" id="reset" type="button">New chat</button>
    </header>

    <div class="messages" id="messages" role="log" aria-live="polite"></div>

    <div class="chips" id="chips">
      <button class="chip" type="button">What is a credit score?</button>
      <button class="chip" type="button">How to stay safe on UPI?</button>
      <button class="chip" type="button">Quiz me on UPI safety</button>
      <button class="chip" type="button">How does SIP work?</button>
    </div>

    <div class="composer">
      <form id="form" autocomplete="off">
        <input id="input" type="text" maxlength="500" placeholder="Ask me about money..." aria-label="Your question">
        <button class="send" id="send" type="submit" aria-label="Send">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.4 20.4 21 12 3.4 3.6 3.3 10l12.6 2-12.6 2z"/></svg>
        </button>
      </form>
      <p class="note">Money Llama teaches ideas. It never tells you what to buy.</p>
    </div>
  </section>
</main>

<script>
(function () {
  var API = "/api/chat";
  var messages = document.getElementById("messages");
  var chips = document.getElementById("chips");
  var form = document.getElementById("form");
  var input = document.getElementById("input");
  var sendBtn = document.getElementById("send");
  var resetBtn = document.getElementById("reset");

  var sessionId = newId();
  var busy = false;
  var typingRow = null;

  var BOOK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M4 19V5.5"/></svg>';

  function newId() {
    if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
    return String(Date.now()) + Math.random().toString(16).slice(2);
  }

  function el(tag, cls, text) {
    var node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function scrollDown() {
    requestAnimationFrame(function () { messages.scrollTop = messages.scrollHeight; });
  }

  /* ---------- message rows ---------- */
  function botRow(contentNode) {
    var row = el("div", "row bot");
    row.appendChild(el("div", "av"));
    var bubble = el("div", "bubble");
    bubble.appendChild(contentNode);
    row.appendChild(bubble);
    messages.appendChild(row);
    scrollDown();
    return row;
  }

  function addUser(text) {
    var row = el("div", "row user");
    row.appendChild(el("div", "bubble", text));
    messages.appendChild(row);
    scrollDown();
  }

  function showTyping() {
    var dots = el("div", "dots");
    dots.appendChild(el("span")); dots.appendChild(el("span")); dots.appendChild(el("span"));
    dots.setAttribute("aria-label", "Money Llama is typing");
    typingRow = botRow(dots);
  }

  function hideTyping() {
    if (typingRow && typingRow.parentNode) typingRow.parentNode.removeChild(typingRow);
    typingRow = null;
  }

  /* ---------- turning the helper's plain text into nice blocks ---------- */
  var RE_EXAMPLE = /^\s*(Example|उदाहरण)\s*[:：]\s*(.*)$/i;
  var RE_REMEMBER = /^\s*(Remember|याद रखें|याद रखिए)\s*[:：]\s*(.*)$/i;
  var RE_LESSON = /^\s*Related lesson\s*:\s*(.*)$/i;
  var RE_POINT = /^\s*[-•]\s+(.*)$/;
  var RE_Q = /^\s*(\d)\s*[.)]\s*(.+)$/;
  var RE_OPT = /^\s*\(?([A-Da-d])[).:]\s*(.+)$/;

  function parseQuiz(lines) {
    var intro = [], outro = [], qs = [], cur = null;
    lines.forEach(function (line) {
      if (line.trim() === "") return;
      var mo = line.match(RE_OPT);
      var mq = line.match(RE_Q);
      if (cur && mo) {
        cur.opts.push({ k: mo[1].toUpperCase(), text: mo[2] });
      } else if (mq) {
        cur = { n: mq[1], text: mq[2], opts: [] };
        qs.push(cur);
      } else if (cur) {
        outro.push(line);
      } else {
        intro.push(line);
      }
    });
    var ok = qs.length >= 2 && qs.every(function (q) { return q.opts.length >= 2; });
    return ok ? { intro: intro, qs: qs, outro: outro } : null;
  }

  function renderQuiz(quiz) {
    var wrap = el("div");
    quiz.intro.forEach(function (t) { wrap.appendChild(el("p", "", t)); });

    var picks = {};
    var optsLists = [];
    var checkBtn = el("button", "btn-main", "Check my answers");
    checkBtn.type = "button";
    checkBtn.disabled = true;

    quiz.qs.forEach(function (q) {
      wrap.appendChild(el("div", "q", q.n + ". " + q.text));
      var list = el("div", "opts");
      optsLists.push(list);
      q.opts.forEach(function (o) {
        var b = el("button", "opt");
        b.type = "button";
        b.appendChild(el("span", "k", o.k));
        b.appendChild(el("span", "", o.text));
        b.addEventListener("click", function () {
          picks[q.n] = o.k;
          Array.prototype.forEach.call(list.children, function (c) { c.classList.remove("picked"); });
          b.classList.add("picked");
          checkBtn.disabled = Object.keys(picks).length < quiz.qs.length;
        });
        list.appendChild(b);
      });
      wrap.appendChild(list);
    });

    checkBtn.addEventListener("click", function () {
      if (busy) return;
      var answer = quiz.qs.map(function (q) { return q.n + picks[q.n]; }).join(" ");
      optsLists.forEach(function (l) { l.classList.add("locked"); });
      checkBtn.disabled = true;
      send(answer);
    });
    wrap.appendChild(checkBtn);
    return wrap;
  }

  function renderBot(text) {
    var lines = text.replace(/\r/g, "").split("\n");

    var quiz = parseQuiz(lines);
    if (quiz) return renderQuiz(quiz);

    var wrap = el("div");
    var list = null;

    // the follow-up suggestion is the last normal line, if it is a short question
    var lastIdx = -1;
    for (var i = lines.length - 1; i >= 0; i--) {
      if (lines[i].trim() === "" || RE_LESSON.test(lines[i])) continue;
      lastIdx = i; break;
    }
    var suggestIdx = -1;
    if (lastIdx > 0) {
      var t = lines[lastIdx].trim();
      var special = RE_EXAMPLE.test(t) || RE_REMEMBER.test(t) || RE_POINT.test(t);
      if (!special && t.length <= 130 && /[?？]$/.test(t)) suggestIdx = lastIdx;
    }

    lines.forEach(function (raw, idx) {
      var line = raw.trim();
      if (line === "") { list = null; return; }

      var m;
      if ((m = line.match(RE_POINT))) {
        if (!list) { list = el("ul", "pts"); wrap.appendChild(list); }
        list.appendChild(el("li", "", m[1]));
        return;
      }
      list = null;

      if ((m = line.match(RE_EXAMPLE))) {
        var ex = el("div", "box ex");
        ex.appendChild(el("span", "label", m[1]));
        ex.appendChild(el("div", "", m[2]));
        wrap.appendChild(ex);
      } else if ((m = line.match(RE_REMEMBER))) {
        var rem = el("div", "box rem");
        rem.appendChild(el("span", "label", m[1]));
        rem.appendChild(el("div", "", m[2]));
        wrap.appendChild(rem);
      } else if ((m = line.match(RE_LESSON))) {
        var pill = el("div", "lesson");
        pill.innerHTML = BOOK;
        pill.appendChild(el("span", "", m[1]));
        wrap.appendChild(pill);
      } else if (idx === suggestIdx) {
        var s = el("button", "suggest", line);
        s.type = "button";
        s.addEventListener("click", function () {
          s.disabled = true;
          send("Yes, please!");
        });
        wrap.appendChild(s);
      } else {
        wrap.appendChild(el("p", "", line));
      }
    });
    return wrap;
  }

  function addBot(text) { botRow(renderBot(text)); }

  /* ---------- talking to the backend ---------- */
  function setBusy(on) {
    busy = on;
    sendBtn.disabled = on;
    input.disabled = on;
  }

  async function send(text) {
    text = (text || "").trim();
    if (!text || busy) return;
    addUser(text);
    chips.classList.add("hidden");
    input.value = "";
    setBusy(true);
    showTyping();
    try {
      var res = await fetch(API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ session_id: sessionId, message: text })
      });
      var data = await res.json();
      hideTyping();
      addBot(data.reply || "Hmm, my reply came out empty. Could you ask that again?");
    } catch (err) {
      hideTyping();
      addBot("Oops, I can't reach my brain right now. Is the server running? Start it with: python server.py");
    } finally {
      setBusy(false);
      if (window.matchMedia("(hover: hover)").matches) input.focus();
    }
  }

  /* ---------- start / reset ---------- */
  function welcome() {
    var wrap = el("div");
    wrap.appendChild(el("p", "", "Hi, I\u2019m Mr. Llama!"));
    wrap.appendChild(el("p", "", "Got a money question? Ask me anything about personal finance or any money question on your mind. "));
    botRow(wrap);
  }

  function reset() {
    if (busy) return;
    messages.innerHTML = "";
    sessionId = newId();
    chips.classList.remove("hidden");
    welcome();
    input.focus();
  }

  form.addEventListener("submit", function (e) { e.preventDefault(); send(input.value); });
  resetBtn.addEventListener("click", reset);
  Array.prototype.forEach.call(chips.children, function (c) {
    c.addEventListener("click", function () { send(c.textContent); });
  });

  welcome();
})();
</script>
</body>
</html>
